{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EventFaces uses the camera to scan event QR codes and take the selfies that find your photos. Selfies are deleted right after matching."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EventFaces nutzt die Kamera, um QR-Codes von Events zu scannen und die Selfies aufzunehmen, mit denen wir deine Fotos finden. Selfies werden direkt nach dem Abgleich gelöscht."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EventFaces"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EventFaces"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EventFaces saves the event photos you choose to your photo library. It never reads your library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EventFaces speichert die Event-Fotos, die du auswählst, in deiner Fotomediathek. Deine Mediathek wird nie gelesen."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EventFaces uses Face ID to unlock the app when you turn on the app lock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EventFaces nutzt Face ID zum Entsperren, wenn du die App-Sperre einschaltest."
          }
        }
      }
    }
  }
}
