        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das Telefon auf Augenhöhe"
          }
        }
      }
    },
    "Importing from Google Drive…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import aus Google Drive …"
          }
        }
      }
    },
    "It shows private information" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es zeigt private Informationen"
          }
        }
      }
    },
    "It's inappropriate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist unangemessen"
          }
        }
      }
    },
    "It's me and I want it removed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin darauf und möchte, dass es entfernt wird"
          }
        }
      }
    },
    "It's too bright. Avoid direct sunlight or strong light behind the camera." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist zu hell. Vermeide direktes Sonnenlicht oder starkes Licht hinter der Kamera."
          }
        }
      }
    },
    "It's too dark. Move to a brighter place or face a window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist zu dunkel. Geh an einen helleren Ort oder schau zu einem Fenster."
          }
        }
      }
    },
    "Join an event" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einem Event beitreten"
          }
        }
      }
    },
    "Join event" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event beitreten"
          }
        }
      }
    },
    "Join your event" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tritt deinem Event bei"
          }
        }
      }
    },
    "Just you" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur du"
          }
        }
      }
    },
    "Keep still for a moment" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halt einen Moment still"
          }
        }
      }
    },
    "Keep your head level: don't look up or down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Kopf gerade: Schau nicht nach oben oder unten."
          }
        }
      }
    },
    "Keep your head straight" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Kopf gerade"
          }
        }
      }
    },
    "Keep your head straight: don't tilt it sideways." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Kopf gerade: Neig ihn nicht zur Seite."
          }
        }
      }
    },
    "Language" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache"
          }
        }
      }
    },
    "Last used %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuletzt genutzt am %@"
          }
        }
      }
    },
    "Less certain. Tell us if these are you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger sicher. Sag uns, ob du das bist."
          }
        }
      }
    },
    "Let's try that again" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuchen wir es noch einmal"
          }
        }
      }
    },
    "Light" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hell"
          }
        }
      }
    },
    "Lock with %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ sperren"
          }
        }
      }
    },
    "Look straight at the camera" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau direkt in die Kamera"
          }
        }
      }
    },
    "Lots of people are searching right now. Try again in a few seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade suchen sehr viele. Versuch es in ein paar Sekunden erneut."
          }
        }
      }
    },
    "Lots of people are searching right now. We'll email you when your photos are ready, and show them here if this screen is still open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade suchen sehr viele. Wir schicken dir eine E-Mail, sobald deine Fotos bereit sind, und zeigen sie hier, wenn dieser Bildschirm noch offen ist."
          }
        }
      }
    },
    "Lower your chin a little" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senk dein Kinn ein wenig"
          }
        }
      }
    },
    "Make sure only you are in the picture" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte darauf, dass nur du im Bild bist"
          }
        }
      }
    },
    "Manage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwalten"
          }
        }
      }
    },
    "Members" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitglieder"
          }
        }
      }
    },
    "More than one face is visible. Make sure you're alone in the picture." : {
