    "This download link has expired. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Download-Link ist abgelaufen. Versuch es erneut."
          }
        }
      }
    },
    "This event is invite-only. Use the link from your invitation email." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Event ist nur mit Einladung zugänglich. Nutze den Link aus deiner Einladungs-E-Mail."
          }
        }
      }
    },
    "This event is invite-only: invite people from the web dashboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Event ist nur mit Einladung zugänglich: Lade Personen über das Web-Dashboard ein."
          }
        }
      }
    },
    "This file type isn't supported. Use JPEG, PNG or HEIC." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Dateityp wird nicht unterstützt. Nutze JPEG, PNG oder HEIC."
          }
        }
      }
    },
    "This invitation has expired or was already used. Ask the organizer for a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einladung ist abgelaufen oder wurde schon benutzt. Bitte den Veranstalter um eine neue."
          }
        }
      }
    },
    "This invitation is for a different email address. Sign in with the address it was sent to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einladung gilt für eine andere E-Mail-Adresse. Melde dich mit der Adresse an, an die sie geschickt wurde."
          }
        }
      }
    },
    "This is me" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das bin ich"
          }
        }
      }
    },
    "This permanently deletes your account, your event memberships, the photos you matched, the photos you uploaded and your devices. It can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden dein Konto, deine Event-Mitgliedschaften, deine Treffer, deine hochgeladenen Fotos und deine Geräte endgültig gelöscht. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
    "This photo is too large." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Foto ist zu groß."
          }
        }
      }
    },
    "This search didn't finish. Search again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Suche wurde nicht abgeschlossen. Such erneut."
          }
        }
      }
    },
    "This sign-in link has expired or was already used. Request a new code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Anmeldelink ist abgelaufen oder wurde schon benutzt. Fordere einen neuen Code an."
          }
        }
      }
    },
    "This version is no longer supported. Update the app to keep finding your photos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version wird nicht mehr unterstützt. Aktualisiere die App, um weiter deine Fotos zu finden."
          }
        }
      }
    },
    "Three quick photos help us find you reliably. They're deleted right after matching." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei kurze Fotos helfen uns, dich zuverlässig zu finden. Sie werden direkt nach dem Abgleich gelöscht."
          }
        }
      }
    },
    "Three short shots help us find you. Your selfie is deleted right after matching." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei kurze Aufnahmen helfen uns, dich zu finden. Dein Selfie wird direkt nach dem Abgleich gelöscht."
          }
        }
      }
    },
    "Too bright: move out of direct light" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu hell: Geh aus dem direkten Licht"
          }
        }
      }
    },
    "Too dark: face a window or lamp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu dunkel: Schau zu einem Fenster oder einer Lampe"
          }
        }
      }
    },
    "Too many tries. Wait a few minutes, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Versuche. Warte ein paar Minuten und versuch es dann erneut."
          }
        }
      }
    },
    "Too many uploads at once. Wait a little, then retry." : {
      "localizations" : {
        "de" : {
