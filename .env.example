# Copy to .env and adjust. Never commit .env.

# --- General ---
# development | test | production
ENVIRONMENT=development
# used in email links
FRONTEND_URL=http://localhost:3000
# true in production (HTTPS)
COOKIE_SECURE=false
# Tailscale auth key, only needed for `docker compose --profile demo up -d tailscale`.
# Use a reusable, NON-ephemeral key and disable key expiry on the machine in the admin
# console: ephemeral nodes are deleted while the host sleeps. Treat as a secret.
TS_AUTHKEY=
# Demo over Funnel: set both to the public hostname, or the dev server answers 403 to
# its own scripts (login never hydrates) and emailed links point at localhost.
#ALLOWED_DEV_ORIGIN=eventface.<tailnet>.ts.net
#FRONTEND_URL=https://eventface.<tailnet>.ts.net

# --- Secrets (generate with: openssl rand -hex 32) ---
JWT_SECRET=change-me-dev-only-secret-change-me-dev-only
DOWNLOAD_TOKEN_SECRET=change-me-download-secret-change-me-dev
# Signs payment confirmations (webhooks) from the payment provider (services/billing)
PAYMENTS_WEBHOOK_SECRET=change-me-payments-webhook-secret-dev-only
# Only the fake (TEST MODE) payment provider exists so far; production needs this to run it (UAT).
#ALLOW_TEST_PAYMENTS=true

# --- Postgres ---
# POSTGRES_USER owns the schema and is used ONLY for migrations. The app and workers
# connect as the least-privilege role eventfaces_app (DML only; created by migration 0007).
POSTGRES_USER=eventfaces
POSTGRES_PASSWORD=eventfaces
POSTGRES_DB=eventfaces
APP_DB_PASSWORD=eventfaces_app_dev
DATABASE_URL=postgresql+psycopg://eventfaces_app:eventfaces_app_dev@db:5432/eventfaces
MIGRATION_DATABASE_URL=postgresql+psycopg://eventfaces:eventfaces@db:5432/eventfaces
TEST_DATABASE_URL=postgresql+psycopg://eventfaces_app:eventfaces_app_dev@db:5432/eventfaces_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://eventfaces:eventfaces@db:5432/eventfaces_test

# --- Redis (password required) ---
REDIS_PASSWORD=eventfaces_redis_dev
REDIS_URL=redis://:eventfaces_redis_dev@redis:6379/0
TEST_REDIS_URL=redis://:eventfaces_redis_dev@redis:6379/15

# --- Object storage (SeaweedFS S3 locally; R2/S3 in production) ---
S3_ENDPOINT_URL=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=eventfaces
S3_ACCESS_KEY=eventfaces-dev
S3_SECRET_KEY=eventfaces-dev-secret
# Public endpoint used only for presigned guest uploads (Phase 4)
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# --- Email (Mailpit locally: UI at http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=EventFaces <no-reply@eventfaces.local>

# --- Google Drive import (Phase 2) ---
# Service account key JSON, either inline or as a file path mounted into the container.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Face search ---
# Cosine similarity cutoffs: results >= FACE_MATCH_THRESHOLD are "possible matches",
# >= MATCH_BEST_THRESHOLD are "best matches". Tune with the Match quality dashboard.
FACE_MATCH_THRESHOLD=0.45
MATCH_BEST_THRESHOLD=0.55

# --- Selfie capture & quality gate ---
# File-upload selfies need this AND the event's "allow selfie file upload" setting.
ALLOW_SELFIE_FILE_UPLOAD=false
CAPTURE_TOKEN_SECONDS=60
SELFIE_MIN_WIDTH=640
SELFIE_MIN_HEIGHT=480
SELFIE_MIN_DET_SCORE=0.8
# Face height as a fraction of the frame height
SELFIE_FACE_HEIGHT_MIN=0.30
SELFIE_FACE_HEIGHT_MAX=0.60
# Head pose limits in degrees
SELFIE_MAX_YAW=20
SELFIE_MAX_PITCH=15
SELFIE_MAX_ROLL=15
# The front shot must face the camera; left/right shots must turn at least this much
SELFIE_FRONT_MAX_YAW=12
SELFIE_SIDE_MIN_YAW=5
# Sharpness: Laplacian variance of the face normalized to 160 px height
SELFIE_MIN_BLUR=30
# Mean face brightness (0-255)
SELFIE_MIN_BRIGHTNESS=60
SELFIE_MAX_BRIGHTNESS=210
# Minimum similarity between the 3 shots (they must show the same person)
SELFIE_SAME_PERSON_MIN=0.5
# Ignore detections below this confidence (0-1)
FACE_MIN_DET_SCORE=0.5
# Detector input size; larger finds smaller faces in group shots but is slower on CPU
FACE_DET_SIZE=640
# How long a user can re-open/download photos they matched (capped at event access end)
SEARCH_GRANT_DAYS=7
# Largest file accepted from Drive import (bytes)
MAX_IMPORT_BYTES=52428800

# --- Rate limits / lockout ---
# How many trusted proxies append to X-Forwarded-For in front of the API.
# 0 = ignore the header (local dev). Behind one load balancer/edge proxy: 1.
TRUSTED_PROXY_HOPS=0
# attempts / seconds per IP+email
LOGIN_RATE_LIMIT=10/300
# attempts / seconds per IP
JOIN_RATE_LIMIT=20/300
JOIN_LOCKOUT_ATTEMPTS=5
JOIN_LOCKOUT_SECONDS=900
# selfie searches per user (and 3x per IP) / seconds
SEARCH_RATE_LIMIT=10/600
# Across all accounts in one event (anti-scraping ceiling)
SEARCH_EVENT_RATE_LIMIT=600/600
# Face work admitted per API process (in flight + queued). Size as searches/s per process
# × acceptable wait (default 6 ≈ 7 s). Beyond it a search waits this many seconds for a
# slot, then gets 503 "busy, try again"
#SEARCH_MAX_CONCURRENT=6
#SEARCH_QUEUE_WAIT_SECONDS=5
# Busy searches are queued in memory and the user is emailed when done (0 = off: 503 instead)
#SEARCH_OVERFLOW_QUEUE_SIZE=20
#SEARCH_QUEUE_MAX_BYTES=67108864
#SEARCH_QUEUE_TTL_SECONDS=900
# Face engine: "insightface" or "package.module:Class" (see backend/app/services/face_engine.py)
#FACE_ENGINE=insightface
# DB connections per process (pool + overflow); keep processes x total under Postgres max_connections
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=20
# Argon2 password hashes at once per process (~64 MiB each); excess waits, then 503
#PASSWORD_HASH_MAX_CONCURRENT=4
#PASSWORD_HASH_WAIT_SECONDS=3

# --- Abuse limits (defaults shown) ---
# Pixel limits checked from the image header before decoding
#SELFIE_MAX_PIXELS=50000000
#IMAGE_MAX_PIXELS=120000000
# Live guest uploads per user per event / per event
#GUEST_UPLOAD_MAX_PER_USER=200
#GUEST_UPLOAD_MAX_PER_EVENT=5000
# A rotated refresh token replayed after this many seconds revokes the session
#REFRESH_REUSE_GRACE_SECONDS=20

# --- iOS app (see DEPLOYMENT.md "iOS app") ---
# Universal Links: your Apple Developer Team ID (10 chars) and the app's bundle id.
# Read by the web container; leave empty until the app ships.
#APPLE_TEAM_ID=
#IOS_BUNDLE_ID=
# Apps older than this get "update required" (HTTP 426) on every request.
#IOS_MIN_SUPPORTED_VERSION=1.0.0
#IOS_LATEST_VERSION=1.0.0
#IOS_UPDATE_URL=https://apps.apple.com/app/idXXXXXXXXXX
# Passwordless sign-in codes
#MOBILE_CODE_TTL_MINUTES=10
#MOBILE_CODE_MAX_ATTEMPTS=5
#MOBILE_CODE_REQUEST_RATE_LIMIT=5/900
#MOBILE_CODE_VERIFY_RATE_LIMIT=20/900
# APNs push (token-based .p8 key from the Apple Developer portal). Push is off until all
# four are set. Keep the key in your secret store; production needs APNS_ENV=production.
#APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#APNS_KEY_ID=
#APNS_TEAM_ID=
#APNS_TOPIC=
#APNS_ENV=production
# App Attest (report-only: results are recorded on the device and logged, nothing is
# blocked). Off until set to "<Team ID>.<bundle id>"; production needs APP_ATTEST_ENV=production.
#APP_ATTEST_APP_ID=ABCDE12345.app.eventfaces.ios
#APP_ATTEST_ENV=production

# --- Error tracking (self-hosted GlitchTip; DEPLOYMENT.md "Monitoring") ---
# Off in development when empty. Production needs SENTRY_DSN (API + Celery project) and
# should set WEB_SENTRY_DSN (web project). Use the internal host so keys never leave the
# server: http://<key>@glitchtip:8000/<project id>.
SENTRY_DSN=
WEB_SENTRY_DSN=
#SENTRY_TRACES_SAMPLE_RATE=0.05
# The glitchtip container's own secrets (production: openssl rand -base64 48).
GLITCHTIP_SECRET_KEY=change-me-glitchtip-secret-change-me
GLITCHTIP_DB_PASSWORD=glitchtip_dev_password
#GLITCHTIP_EMAIL_URL=smtp://user:password@smtp.example.org:587
#GLITCHTIP_FROM_EMAIL=errors@example.org
# Contact form recipient (POST /api/contact); empty = LEGAL_EMAIL. Messages are not stored.
#CONTACT_EMAIL=hello@example.org
# GlitchTip heartbeat check-in URLs (DEPLOYMENT.md section 8); empty = off.
#RETENTION_HEARTBEAT_URL=http://glitchtip:8000/api/0/organizations/<org>/heartbeat_check/<id>/
#DISK_HEARTBEAT_URL=https://errors.photos.example.org/api/0/organizations/<org>/heartbeat_check/<id>/

# Operator identity for the Impressum, Terms and Privacy Notice (services/legal.py).
# Production refuses to start while a required one is empty. See LEGAL_REVIEW.md.
#LEGAL_OPERATOR_NAME=Example Photos GmbH
#LEGAL_OPERATOR_ADDRESS=Musterstraße 1\n10115 Berlin
#LEGAL_REPRESENTATIVE=Erika Mustermann
#LEGAL_EMAIL=legal@example.org
#LEGAL_PHONE=+49 30 1234567
#LEGAL_DPO_CONTACT=dpo@example.org
#LEGAL_SUPERVISORY_AUTHORITY=Berliner Beauftragte für Datenschutz und Informationsfreiheit
#LEGAL_EMAIL_PROVIDER=Example Mail GmbH, Germany
#LEGAL_REGISTER=Amtsgericht Berlin-Charlottenburg, HRB 123456
#LEGAL_VAT_ID=DE123456789
#LEGAL_HOSTING_PROVIDER=Hetzner Online GmbH, Gunzenhausen (Germany)
#LEGAL_STORAGE_PROVIDER=Cloudflare, Inc. (R2 object storage, EU jurisdiction)
